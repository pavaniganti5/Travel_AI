# TravelAI Backend Configuration
APP_NAME=TravelAI API
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# MongoDB Connection
# Set to your MongoDB connection string (e.g. mongodb://localhost:27017 or MongoDB Atlas URI)
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=travelai_db

# AI Provider ("auto", "gemini", "openai", "mock")
AI_PROVIDER=auto

# Optional: Add your API keys below for live LLM API generation
# Google Gemini API Key (Get at: https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (Get at: https://platform.openai.com/)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Murf text-to-speech (keep this key in the backend environment only)
MURF_API_KEY=
MURF_VOICE_ID=Natalie
MURF_LOCALE=en-US
